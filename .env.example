# SMART GUARDIAN CONFIGURATION
ENVIRONMENT=development
LOG_LEVEL=INFO

# Option A: Local SQLite database for immediate zero-config testing (no PostgreSQL required)
DATABASE_URL=sqlite+aiosqlite:///./smart_guardian.db
SYNC_DATABASE_URL=sqlite:///./smart_guardian.db

# Option B: Local PostgreSQL / TimescaleDB (replace with your postgres credentials)
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/smart_guardian
# SYNC_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/smart_guardian

# Ingestion Rate Limiting
RATE_LIMIT_PER_SOURCE_PER_MINUTE=300
RATE_LIMIT_PER_WELL_PER_MINUTE=60

# Production Surveillance Defaults
DEFAULT_WC_THRESHOLD_PERCENT=80.0
DEFAULT_WC_TREND_WINDOW_HOURS=24
DEFAULT_ALERT_COOLDOWN_MINUTES=60
DEFAULT_SURVEILLANCE_INTERVAL_MINUTES=5
